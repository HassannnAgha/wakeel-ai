# Secrets
.env

# Generated indexes. Rebuilt from pdfs/ by index_pdfs(), so they are not
# committed: chroma.sqlite3 and bm25.pkl are binaries git cannot merge, and
# two people committing them would conflict on every re-index.
texts/
metadata/
bm25_index/
chroma_storeee/
db/

# Source judgments: committed on this branch so Warda has the same corpus.
# The scraper only finds ~11% of candidate numbers, so re-scraping would
# produce a different set.

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.vscode/

# Shared index archive

